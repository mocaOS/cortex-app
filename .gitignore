nginx/ssl/

# A bare `scripts/` (directory-node) pattern would make it impossible for any
# negation below to re-include individual files — an excluded directory node is
# never traversed, so per-file `!` rules inside it never get evaluated (a known
# git gitignore limitation). `/scripts/*` ignores its contents item-by-item
# instead, which is what lets the .mjs negation below actually take effect.
/scripts/*
# Repo-tracked release tooling (e.g. check-version-sync.mjs, build-stack-json.mjs,
# and their node:test files) is committed on purpose; everything else in scripts/
# (local one-off scripts like download-documents.ts) stays ignored.
!/scripts/*.mjs
!frontend/public/skills/library/scripts/

# Downloaded documents
documents
!frontend/**/documents

# Bench harness — input docs, run outputs, and locally-edited config stay out of git.
# The orchestrator code and .yaml.example templates ARE tracked.
# NOTE: `!bench/logs/` overrides the broader `logs/` rule above so we can keep
# the directory present with a .gitkeep while ignoring its contents.
!bench/logs/
bench/files/*
!bench/files/.gitkeep
bench/logs/*
!bench/logs/.gitkeep
bench/backups/*
!bench/backups/.gitkeep
bench/models.yaml
bench/combos.yaml
bench/qa_models.yaml
bench/_probe_thinking.py
bench/__pycache__/

# Skills *.zip
library.zip
# Git connector clone working copies
backend/git_repos/
git_repos/

# Claude Code scheduled-tasks lock (machine-local state)
.claude/scheduled_tasks.lock

# Venice capacity-planning report (local working doc, never commit)
venice.md
venice-partner-brief.md
venice-projection.ods
HANDOVER-BUILDER.md
HANDOVER-FINANCE.md

# Created by the selfhost compose verification; the real ops/ is copied in at
# install time by the installer (or by hand, per selfhost/README.md).
selfhost/ops
